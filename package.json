{
  "name": "dsh-ci-runner",
  "version": "0.1.0",
  "description": "Trigger GitHub Actions workflow runs and local test pipelines, stream their logs back, and on failure hand the tail of the log to DeepSeek for a Markdown root-cause diagnosis.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "github-actions",
    "ci",
    "workflow-dispatch",
    "check-run",
    "test",
    "diagnosis"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./adapter": "./src/adapter.js"
  },
  "bin": {
    "ci-runner": "./bin/ci-runner.mjs"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "test": "node --test",
    "cli": "node bin/ci-runner.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
